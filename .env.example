# ─── Supabase ────────────────────────────────────────────────────────────────
# From https://app.supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
EXPO_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref-id

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# From https://console.cloud.google.com → APIs & Services → Credentials
# Create one OAuth client per platform. The matching one is used at runtime.
# Web client ID is also needed for Supabase Google provider setup.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
